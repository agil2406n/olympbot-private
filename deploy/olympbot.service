[Unit]
Description=OlympBot Demo 1-minute trading service
After=network-online.target olympbot-xvfb.service
Wants=network-online.target
Requires=olympbot-xvfb.service

[Service]
Type=simple
User=olympbot
Group=olympbot
WorkingDirectory=/opt/olympbot/app
Environment=DISPLAY=:99
Environment=AUTO_OPEN_PANEL=false
Environment=PANEL_HOST=127.0.0.1
Environment=PANEL_PORT=5000
Environment=PLATFORM_DEMO_EXECUTION=true
Environment=DEMO_LEARNING_MODE=true
Environment=DEMO_LEARNING_MIN_SCORE=90
Environment=MAX_DAILY_TRADES=5
Environment=MAX_DAILY_LOSS=5
Environment=AI_CONFIRMATION_ENABLED=false
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONUTF8=1
Environment=PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64
ExecStart=/opt/olympbot/venv/bin/python /opt/olympbot/app/OlympBot_Professional.py
Restart=always
RestartSec=8
TimeoutStopSec=20
KillMode=mixed
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/olympbot

[Install]
WantedBy=multi-user.target
